# === Frontend Environment Variables (Place in frontend/.env) ===
# URL where the Frontend will send API requests
VITE_API_URL=http://localhost:8000

# === Backend Environment Variables (Place in backend/.env) ===
# Database configuration 
# SQLALCHEMY_DATABASE_URL=sqlite:///./cropdoc.db

# CORS Configuration (Comma separated whitelist of frontend domains)
ALLOWED_ORIGINS=http://localhost:4173,http://localhost:5173,http://localhost:5174,http://localhost:5176

# Machine Learning Setup
# Indicates model is expected to be loaded in inference.py
MODEL_PATH=../data/model.pth
